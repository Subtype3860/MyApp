# Пример /etc/myapp/media-replica.env
# Права: chown root:myapp, chmod 640

# Куда копировать:
#   - на резервный сервер по SSH: backup@10.8.8.9:/srv/myapp-media
#   - или на локальный/смонтированный диск: /mnt/backup/myapp-media
TARGET=backup@10.8.8.9:/srv/myapp-media

# Ключ SSH для пользователя myapp (без пароля, только для rsync).
RSYNC_SSH="ssh -i /home/myapp/.ssh/myapp-media-replica -o BatchMode=yes -o StrictHostKeyChecking=accept-new"

# Источники (значения по умолчанию совпадают с appsettings.json).
SOURCE_PHOTO=/mnt/dietpi/img
SOURCE_VIDEO=/mnt/dietpi/video
SOURCE_STAGING_PHOTO=/opt/myapp/media-staging/img
SOURCE_STAGING_VIDEO=/opt/myapp/media-staging/video

# Требовать, чтобы /mnt/dietpi/img и /mnt/dietpi/video были точками монтирования.
REQUIRE_MOUNT=1

# Удалять в резервной копии файлы, которых больше нет в источнике.
ALLOW_DELETE=1
